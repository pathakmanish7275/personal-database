# ─────────────────────────────────────────────────────────────────────────────
# LLM Provider
# ─────────────────────────────────────────────────────────────────────────────
# Choose one: ollama | gemini | openai | anthropic
# If the chosen provider fails (bad key, network outage), the system automatically
# falls back to local Ollama so the assistant stays available.
LLM_PROVIDER=ollama

# ─────────────────────────────────────────────────────────────────────────────
# Ollama (local — always used for embeddings regardless of LLM_PROVIDER)
# ─────────────────────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434

# Host for the chat LLM only, speaking the Ollama-compatible API. Point this
# at a separate server (e.g. FLM serving an NPU model on its own port); it
# defaults to OLLAMA_HOST if unset. Embeddings always stay on OLLAMA_HOST.
# LLM_HOST=http://localhost:52625

# The Ollama model used for chat synthesis when LLM_PROVIDER=ollama.
# Swap this to any model you have pulled:
#   Low-power machines  → llama3.2:3b, phi3:mini, qwen2.5:3b
#   Mid-range           → llama3.1:8b, mistral:7b, gemma2:9b
#   High-end            → gpt-oss:20b, llama3.3:70b, qwq:32b
LLM_MODEL=qwen3.5:4b
# Controls thinking for models that support it (e.g. qwen3.5).
# "auto" (default) → disabled for non-:2b models; omitted for :2b (2b loses
#   tool-use reliability when thinking is explicitly off).
# Set to true/false to override.
LLM_THINKING=auto

# Where the Ollama fallback runs when the primary chat LLM lives on a separate
# server (LLM_HOST). Must be a model the fallback host actually has.
# FALLBACK_LLM_HOST=http://localhost:11434
# FALLBACK_LLM_MODEL=qwen3.5:4b

# ─── agent loop ──────────────────────────────────────────────────────────────
# Chat runs as an agent: the model is given a search_kb tool and decides for
# itself whether to search the knowledge base, how to word the query, and
# whether to search again. Greetings and general-knowledge questions skip
# retrieval entirely.
#
# NOTE: this requires a model with tool-calling support, reached over the
# OpenAI-format endpoint. FLM's Ollama-format /api/chat silently DROPS the
# tools array. qwen3.5 supports tool calling; gpt-oss does not.

# How many times the model may call search_kb in one turn before it must answer
# with what it has. 2 allows one retry with better terms.
# MAX_TOOL_TURNS=2

# Reasoning is requested per role. Choosing a good search query benefits from
# it; synthesising an answer from passages already in hand mostly spends decode
# on reasoning nobody reads. Reasoning arrives on its own channel and never
# appears in the answer.
# THINK_TOOL_TURNS=true
# THINK_ANSWER=false

# Hard ceiling on a tool turn's output (reasoning + tool call together). A
# thinking turn can otherwise spiral to the context cap — measured at 4096
# tokens / 245s on one vague question, entirely inside the reasoning channel.
# If the cap is hit before a tool call appears, the agent searches the user's
# raw question rather than returning nothing.
# TOOL_TURN_MAX_TOKENS=768
# ANSWER_MAX_TOKENS=0        # 0 = uncapped; the answer needs room

# Embedding model (always local; nomic-embed-text is fast and good on CPU)
EMBED_MODEL=nomic-embed-text

# ─────────────────────────────────────────────────────────────────────────────
# Gemini (Google — free tier covers Flash models)
# ─────────────────────────────────────────────────────────────────────────────
# LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash-lite
# GEMINI_API_KEY=...   ← put your real key in .env, never here

# ─────────────────────────────────────────────────────────────────────────────
# OpenAI
# ─────────────────────────────────────────────────────────────────────────────
# LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=...   ← put your real key in .env, never here

# ─────────────────────────────────────────────────────────────────────────────
# Anthropic
# ─────────────────────────────────────────────────────────────────────────────
# LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# ANTHROPIC_API_KEY=...   ← put your real key in .env, never here

# ─────────────────────────────────────────────────────────────────────────────
# Storage paths (relative to project root)
# ─────────────────────────────────────────────────────────────────────────────
DATA_DIR=./data
QDRANT_PATH=./data/qdrant
KUZU_PATH=./data/kuzu/personal.db
RAW_DIR=./data/raw

# ─────────────────────────────────────────────────────────────────────────────
# Retrieval knobs
# ─────────────────────────────────────────────────────────────────────────────
TOP_K_VECTOR=6
TOP_K_GRAPH=10
RERANK_TOP_N=8
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MIN_SIMILARITY_SCORE=0.45

# ─────────────────────────────────────────────────────────────────────────────
# Memory compaction
# ─────────────────────────────────────────────────────────────────────────────
MEMORY_TOKEN_BUDGET=4000
MEMORY_KEEP_RECENT_TURNS=2
MEMORY_SUMMARY_MAX_CHARS=2400

# ─────────────────────────────────────────────────────────────────────────────
# Knowledge graph extraction (non-LLM — GLiNER + REBEL, runs on CPU)
# ─────────────────────────────────────────────────────────────────────────────
KG_ENABLED=true
KG_RELATIONS=true
GLINER_MODEL=urchade/gliner_small-v2.1
REBEL_MODEL=Babelscape/rebel-large
KG_ENTITY_THRESHOLD=0.5

# ─── voice ───────────────────────────────────────────────────────────────────
# Voice shares the same UI, agent and sessions as text: a spoken turn runs the
# same agent loop and is persisted to the same chat thread. Speech-to-text and
# text-to-speech run as separate local HTTP servers speaking the OpenAI audio
# API, so either can be swapped (including for a cloud provider) by URL alone.
# run.sh starts them from VOICE_AGENT_DIR if a venv is present there.
# VOICE_ENABLED=true
# VOICE_AGENT_DIR=~/Desktop/Local-pipecat-agent.

# NB: 8123 rather than the upstream default of 8000 — port 8000 is often taken
# (on this machine by an unrelated API whose /health also returns 200, which
# made the call button falsely report ready).
# STT_BASE_URL=http://localhost:8123/v1
# TTS_BASE_URL=http://localhost:8880/v1
# TTS_VOICE=af_heart

# Reasoning off for speech: it is the largest latency cost and helps least when
# the answer must be two or three spoken sentences.
# VOICE_THINK=false
# VOICE_ANSWER_MAX_TOKENS=300
# VOICE_GREETING=Hey. What would you like to know?
# Spoken when the call is placed on a conversation that already has turns.
# VOICE_RESUME_GREETING=Picking up where we left off. What would you like to know?
