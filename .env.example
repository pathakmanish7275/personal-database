# ─────────────────────────────────────────────────────────────────────────────
# LLM Provider
# ─────────────────────────────────────────────────────────────────────────────
# Choose one: ollama | gemini | openai | anthropic
# If the chosen provider fails (bad key, network outage), the system automatically
# falls back to local Ollama so the assistant stays available.
LLM_PROVIDER=ollama

# ─────────────────────────────────────────────────────────────────────────────
# Ollama (local — always used for embeddings regardless of LLM_PROVIDER)
# ─────────────────────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434

# The Ollama model used for chat synthesis when LLM_PROVIDER=ollama.
# Swap this to any model you have pulled:
#   Low-power machines  → llama3.2:3b, phi3:mini, qwen2.5:3b
#   Mid-range           → llama3.1:8b, mistral:7b, gemma2:9b
#   High-end            → gpt-oss:20b, llama3.3:70b, qwq:32b
LLM_MODEL=qwen3.5:4b
# Controls thinking for models that support it (e.g. qwen3.5).
# "auto" (default) → disabled for non-:2b models; omitted for :2b (2b loses
#   tool-use reliability when thinking is explicitly off).
# Set to true/false to override.
LLM_THINKING=auto

# Embedding model (always local; nomic-embed-text is fast and good on CPU)
EMBED_MODEL=nomic-embed-text

# ─────────────────────────────────────────────────────────────────────────────
# Gemini (Google — free tier covers Flash models)
# ─────────────────────────────────────────────────────────────────────────────
# LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash-lite
# GEMINI_API_KEY=...   ← put your real key in .env, never here

# ─────────────────────────────────────────────────────────────────────────────
# OpenAI
# ─────────────────────────────────────────────────────────────────────────────
# LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=...   ← put your real key in .env, never here

# ─────────────────────────────────────────────────────────────────────────────
# Anthropic
# ─────────────────────────────────────────────────────────────────────────────
# LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# ANTHROPIC_API_KEY=...   ← put your real key in .env, never here

# ─────────────────────────────────────────────────────────────────────────────
# Storage paths (relative to project root)
# ─────────────────────────────────────────────────────────────────────────────
DATA_DIR=./data
QDRANT_PATH=./data/qdrant
KUZU_PATH=./data/kuzu/personal.db
RAW_DIR=./data/raw

# ─────────────────────────────────────────────────────────────────────────────
# Retrieval knobs
# ─────────────────────────────────────────────────────────────────────────────
TOP_K_VECTOR=6
TOP_K_GRAPH=10
RERANK_TOP_N=8
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MIN_SIMILARITY_SCORE=0.45

# ─────────────────────────────────────────────────────────────────────────────
# Memory compaction
# ─────────────────────────────────────────────────────────────────────────────
MEMORY_TOKEN_BUDGET=4000
MEMORY_KEEP_RECENT_TURNS=2
MEMORY_SUMMARY_MAX_CHARS=2400

# ─────────────────────────────────────────────────────────────────────────────
# Knowledge graph extraction (non-LLM — GLiNER + REBEL, runs on CPU)
# ─────────────────────────────────────────────────────────────────────────────
KG_ENABLED=true
KG_RELATIONS=true
GLINER_MODEL=urchade/gliner_small-v2.1
REBEL_MODEL=Babelscape/rebel-large
KG_ENTITY_THRESHOLD=0.5
